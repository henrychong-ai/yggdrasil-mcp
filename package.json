{
  "name": "yggdrasil-mcp",
  "version": "1.2.9",
  "description": "Reasoning orchestration MCP - Tree of Thoughts with multi-agent evaluation. Fork of Anthropic's sequential-thinking with string coercion fix.",
  "license": "MIT",
  "author": "Henry Chong <henrychong-ai@gmail.com>",
  "contributors": [
    "Anthropic, PBC (original)"
  ],
  "homepage": "https://github.com/henrychong-ai/yggdrasil-mcp",
  "bugs": "https://github.com/henrychong-ai/yggdrasil-mcp/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/henrychong-ai/yggdrasil-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sequential-thinking",
    "tree-of-thoughts",
    "reasoning",
    "llm",
    "ai",
    "claude"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "yggdrasil-mcp": "dist/index.js",
    "mcp-server-sequential-thinking": "dist/index.js"
  },
  "files": [
    "dist",
    "mcpb",
    "cowork-plugin"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "scripts": {
    "build": "shx rm -rf dist && tsc && shx chmod +x dist/*.js",
    "build:mcpb": "bash scripts/build-mcpb.sh",
    "build:cowork-plugin": "bash scripts/build-cowork-plugin.sh",
    "build:dist": "pnpm build:mcpb && pnpm build:cowork-plugin",
    "validate:mcpb": "pnpm exec mcpb validate mcpb/manifest.json",
    "prepare": "husky",
    "watch": "tsc --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "oxlint --max-warnings=0",
    "lint:fix": "oxlint --fix --max-warnings=0",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "fix": "pnpm lint:fix && pnpm format",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck"
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --fix --max-warnings=0",
      "biome format --write"
    ],
    "*.json": [
      "biome format --write"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chalk": "^6.0.0",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "overrides": {
      "@isaacs/brace-expansion": "^5.0.1",
      "hono": ">=4.12.34 <5",
      "@hono/node-server": ">=2.0.5",
      "vite": ">=7.3.6 <8",
      "picomatch": ">=4.0.4",
      "micromatch>picomatch": "^2.3.2",
      "path-to-regexp@>=8.0.0 <8.4.0": ">=8.4.0",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "ip-address": "^10.1.1",
      "tmp": "^0.2.6",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2",
      "fast-uri": ">=3.1.5 <4",
      "body-parser": ">=2.3.0",
      "undici": ">=7.28.0 <8",
      "sharp": ">=0.35.0",
      "esbuild": ">=0.28.1 <0.29",
      "ws": ">=8.21.0"
    }
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.77.0",
    "semver": "^7.8.5",
    "shx": "^0.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "wrangler": "4.119.0"
  }
}
