# Release-maintainer credentials for scripts/r2-prune.sh and the R2 commands in
# RELEASE_RUNBOOK.md. This file is a template: placeholder values only.
#
# Copy it to .env.release.local (git-ignored) and replace each placeholder with a
# reference into your own secret manager. Never put a resolved value in either file.
# With 1Password, for example:
#
#   op run --env-file=.env.release.local -- scripts/r2-prune.sh
#
# resolves the references in memory for that one command and writes nothing to disk.

# S3-compatible access key pair for the R2 bucket (read, write and delete on objects)
R2_ACCESS_KEY_ID=op://your-vault/your-item/access-key-id
R2_SECRET_ACCESS_KEY=op://your-vault/your-item/secret-access-key

# Cloudflare account that owns the bucket (32 hexadecimal characters)
CLOUDFLARE_ACCOUNT_ID=op://your-vault/your-item/account-id
